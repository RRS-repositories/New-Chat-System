# The chat's settings file. On the server it is /opt/chat/.env.
# This example lists the names only. Real values are never stored in this repository.
#
# The chat signs people in through the CRM and uses the CRM's database, so the first group
# must hold THE SAME VALUES as the CRM's settings file. If one of them changes in the CRM
# (for example the database password), change it here too and restart: pm2 restart chat-server
#
# deploy/make-env.sh creates this file on the server by copying these names from the CRM's file.

# ── Shared with the CRM (must match its values) ──────────────────────────
SESSION_JWT_SECRET=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=
REDIS_URL=

# ── Where the CRM answers on this server (used to check a sign-in) ───────
CRM_INTERNAL_URL=http://127.0.0.1:5000

# ── The chat's own settings ──────────────────────────────────────────────
CHAT_PORT=5020
CHAT_PUBLIC_URL=https://chat2.rowanroseclaims.co.uk
CHAT_UPLOADS_DIR=/data/chat-uploads
CHAT_CORS_ORIGINS=
# Per-person IP restriction (set in the CRM's permission editor). Enforced unless this is "false",
# which only logs what would be refused.
IP_RESTRICTION_ENFORCE=
# Only people with the "Team chat (beta)" permission, Management and IT may use the chat. "false" opens it to all staff.
CHAT_REQUIRE_BETA=

# Notifications when the chat is closed (Web Push). Off when the keys are empty.
CHAT_VAPID_PUBLIC=
CHAT_VAPID_PRIVATE=
CHAT_VAPID_SUBJECT=

# Calls. STUN has a free default; TURN is our own relay (coturn) and its shared secret.
CHAT_STUN_URLS=
CHAT_TURN_URLS=
CHAT_TURN_SECRET=

# Daily email of unread mentions. Off unless "true". Needs the mail settings below.
CHAT_DIGEST_ENABLED=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
